{%- comment -%}
  One-colour payment icons for the slim footer. Most come from Shopify and are recoloured in CSS;
  the ones that turn into blobs in a single colour are redrawn here as simple outlines or wordmarks.
{%- endcomment -%}
{%- case type -%}
  {%- when 'master' -%}
    <svg class="icon andoh-pay-mono" viewBox="0 0 38 24" width="38" height="24" role="img" aria-labelledby="pi-andoh-master" xmlns="http://www.w3.org/2000/svg">
      <title id="pi-andoh-master">Mastercard</title>
      <rect x=".5" y=".5" width="37" height="23" rx="2.5" fill="none" stroke="currentColor"/>
      <circle cx="15" cy="12" r="7" fill="none" stroke="currentColor" stroke-width="1.3"/>
      <circle cx="23" cy="12" r="7" fill="none" stroke="currentColor" stroke-width="1.3"/>
    </svg>
  {%- when 'paypal' -%}
    <svg class="icon andoh-pay-mono" viewBox="0 0 38 24" width="38" height="24" role="img" aria-labelledby="pi-andoh-paypal" xmlns="http://www.w3.org/2000/svg">
      <title id="pi-andoh-paypal">PayPal</title>
      <rect x=".5" y=".5" width="37" height="23" rx="2.5" fill="none" stroke="currentColor"/>
      <text x="19" y="15" text-anchor="middle" fill="currentColor" font-family="Verdana, Arial, sans-serif" font-size="8" font-weight="700" font-style="italic" letter-spacing="-.2">PayPal</text>
    </svg>
  {%- else -%}
    {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
{%- endcase -%}
