{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign p = section.settings.product -%}
{%- assign image = section.settings.image | default: p.featured_media.preview_image -%}
{%- assign name = section.settings.heading | default: p.title -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding andoh-feature">
    {%- if section.settings.eyebrow != blank -%}
      <div class="andoh-label andoh-feature__label">{{ section.settings.eyebrow | escape }}</div>
    {%- endif -%}
    <div class="andoh-feature__media andoh-feature__media--{{ section.settings.ratio }}">
      {%- if image != blank -%}
        {{ image | image_url: width: 2400 | image_tag: loading: 'lazy', sizes: '100vw', widths: '750, 1100, 1500, 2000, 2400' }}
      {%- else -%}
        <div class="andoh-frame__art">{% render 'andoh-drawing', view: 'built' %}</div>
      {%- endif -%}
    </div>
    <div class="andoh-feature__body">
      {%- if name != blank -%}<h2 class="h2">{{ name | escape }}</h2>{%- endif -%}
      <div class="rte andoh-feature__text">
        {%- if section.settings.text != blank -%}
          {{ section.settings.text }}
        {%- elsif p != blank -%}
          <p>{{ p.description | strip_html | truncatewords: 40 }}</p>
        {%- endif -%}
      </div>
      {%- if p != blank -%}
        <a class="andoh-link" href="{{ p.url }}">Shop the {{ p.title | downcase | escape }}</a>
      {%- elsif section.settings.link_label != blank -%}
        <a class="andoh-link" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "andoh feature",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "New" },
    { "type": "product", "id": "product", "label": "Product", "info": "Uses the product's photo, name and description unless you fill in the fields below." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "ratio", "label": "Image shape", "default": "wide", "options": [
      { "value": "wide", "label": "Wide (16:9)" },
      { "value": "landscape", "label": "Landscape (3:2)" },
      { "value": "tall", "label": "Tall (4:5)" }
    ] },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link label", "info": "Used when no product is picked." },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 36 }
  ],
  "presets": [{ "name": "andoh feature" }]
}
{% endschema %}
