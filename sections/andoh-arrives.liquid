{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign p = section.settings.product -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="andoh-arrives">
      <div class="andoh-frame">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 58vw, 100vw', widths: '600, 900, 1200, 1600' }}
        {%- elsif p.metafields.andoh.flat_image != blank -%}
          {{ p.metafields.andoh.flat_image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 58vw, 100vw', widths: '600, 900, 1200, 1600' }}
        {%- else -%}
          <div class="andoh-frame__art">{% render 'andoh-drawing', view: 'exploded' %}</div>
        {%- endif -%}
      </div>
      <div>
        <div class="andoh-label">
          {{- section.settings.eyebrow | escape -}}
          {%- if p != blank %} · {{ p.title | escape }}{% endif -%}
        </div>
        <h2 class="h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="andoh-arrives__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if p != blank -%}
          {% render 'andoh-how-it-arrives', product: p, heading: 'In the box' %}
          <a class="andoh-link" href="{{ p.url }}">See the {{ p.title | downcase | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "andoh how it arrives",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "info": "Its box size, parts, assembly time and tools come from the product's andoh metafields." },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Optional. Otherwise the product's flat image, or the exploded line drawing." },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "How it arrives" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Two panels, one slot, no screws." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every piece is drawn to pack flat. That means a smaller box, less air shipped across oceans, and a piece you can take with you when you move.</p>" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 52 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 52 }
  ],
  "presets": [{ "name": "andoh how it arrives" }]
}
{% endschema %}
