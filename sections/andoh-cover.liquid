{%- liquid
  assign image = section.settings.image
  assign mobile_image = section.settings.image_mobile | default: image
  assign overlay = section.settings.overlay | divided_by: 100.0
-%}
<div class="andoh-cover andoh-cover--{{ section.settings.height }} andoh-cover--{{ section.settings.position }} andoh-cover--{{ section.settings.text_color }}">
  <div class="andoh-cover__media">
    {%- if image != blank -%}
      {{ image | image_url: width: 3000 | image_tag: class: 'andoh-cover__img andoh-cover__img--desktop', sizes: '100vw', widths: '750, 1100, 1500, 2000, 2600, 3000', fetchpriority: 'high' }}
      {{ mobile_image | image_url: width: 1500 | image_tag: class: 'andoh-cover__img andoh-cover__img--mobile', sizes: '100vw', widths: '600, 900, 1200, 1500', fetchpriority: 'high' }}
    {%- else -%}
      <div class="andoh-cover__placeholder">{% render 'andoh-drawing', view: 'built' %}</div>
    {%- endif -%}
    <span class="andoh-cover__shade" style="opacity: {{ overlay }}"></span>
  </div>
  <div class="andoh-cover__content">
    <div class="andoh-cover__text">
      {%- if section.settings.eyebrow != blank -%}
        <div class="andoh-label andoh-cover__label">{{ section.settings.eyebrow | escape }}</div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="andoh-cover__heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="andoh-cover__body rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="andoh-link andoh-cover__link" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "andoh cover",
  "tag": "section",
  "class": "section andoh-cover-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Shown edge to edge. 3000px wide or more looks best." },
    { "type": "image_picker", "id": "image_mobile", "label": "Phone image", "info": "Optional. A taller crop for phones." },
    { "type": "select", "id": "height", "label": "Height", "default": "full", "options": [
      { "value": "full", "label": "Full screen" },
      { "value": "large", "label": "Large (80%)" },
      { "value": "medium", "label": "Medium (60%)" }
    ] },
    { "type": "select", "id": "position", "label": "Text position", "default": "bottom-left", "options": [
      { "value": "top-left", "label": "Top left" },
      { "value": "center-left", "label": "Middle left" },
      { "value": "bottom-left", "label": "Bottom left" },
      { "value": "center", "label": "Center" },
      { "value": "bottom-right", "label": "Bottom right" }
    ] },
    { "type": "select", "id": "text_color", "label": "Text color", "default": "light", "options": [
      { "value": "light", "label": "White" },
      { "value": "dark", "label": "Black" }
    ] },
    { "type": "range", "id": "overlay", "label": "Darken image", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 15, "info": "Helps white text read over a bright photo." },
    { "type": "text", "id": "eyebrow", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Objects for slow rooms" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Link label", "default": "Shop all objects" },
    { "type": "url", "id": "button_link", "label": "Link" }
  ],
  "presets": [{ "name": "andoh cover" }]
}
{% endschema %}
