{%- liquid
  assign image = section.settings.image
  assign mobile_image = section.settings.image_mobile | default: image
  assign overlay = section.settings.overlay | divided_by: 100.0
-%}
<div class="andoh-cover andoh-cover--{{ section.settings.height }} andoh-cover--{{ section.settings.position }} andoh-cover--{{ section.settings.text_color }}">
  <div class="andoh-cover__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'andoh-cover__video', image_size: '2000x' }}
    {%- elsif section.settings.video_url != blank -%}
      {%- assign v = section.settings.video_url -%}
      <div class="andoh-cover__embed">
        {%- if v.type == 'youtube' -%}
          <iframe src="https://www.youtube-nocookie.com/embed/{{ v.id }}?autoplay=1&mute=1&loop=1&playlist={{ v.id }}&controls=0&modestbranding=1&playsinline=1&rel=0" title="{{ section.settings.heading | escape }}" allow="autoplay; encrypted-media" tabindex="-1" loading="eager"></iframe>
        {%- else -%}
          <iframe src="https://player.vimeo.com/video/{{ v.id }}?background=1&autoplay=1&loop=1&muted=1" title="{{ section.settings.heading | escape }}" allow="autoplay" tabindex="-1" loading="eager"></iframe>
        {%- endif -%}
      </div>
    {%- elsif image != blank -%}
      {{ image | image_url: width: 3000 | image_tag: class: 'andoh-cover__img andoh-cover__img--desktop', sizes: '100vw', widths: '750, 1100, 1500, 2000, 2600, 3000', fetchpriority: 'high' }}
      {{ mobile_image | image_url: width: 1500 | image_tag: class: 'andoh-cover__img andoh-cover__img--mobile', sizes: '100vw', widths: '600, 900, 1200, 1500', fetchpriority: 'high' }}
    {%- else -%}
      <div class="andoh-cover__placeholder">{% render 'andoh-drawing', view: 'built' %}</div>
    {%- endif -%}
    <span class="andoh-cover__shade" style="opacity: {{ overlay }}"></span>
  </div>
  {%- if section.settings.side_show -%}
    {%- liquid
      assign side_images = ''
      assign s1 = section.settings.side_image_1
      assign s2 = section.settings.side_image_2
      assign s3 = section.settings.side_image_3
    -%}
    {%- assign side_tag = 'div' -%}
    {%- if section.settings.side_link != blank -%}{%- assign side_tag = 'a' -%}{%- endif -%}
    <{{ side_tag }}
      class="andoh-cover__side"
      {% if section.settings.side_link != blank %}href="{{ section.settings.side_link }}" aria-label="{{ section.settings.button_label | default: 'Shop' | escape }}"{% else %}aria-hidden="true"{% endif %}
      style="--andoh-side-w: {{ section.settings.side_width }}%; --andoh-side-open: {{ section.settings.side_open_width }}%;"
      data-interval="{{ section.settings.side_interval | times: 1000 }}"
    >
      {%- if s1 != blank -%}
        {{ s1 | image_url: width: 1600 | image_tag: class: 'andoh-cover__side-img', sizes: '(min-width: 750px) 60vw, 0px', widths: '600, 900, 1200, 1600', alt: '' }}
      {%- else -%}
        <img class="andoh-cover__side-img" src="{{ 'andoh-cover-side.jpg' | asset_url }}" width="1000" height="1491" alt="" fetchpriority="low">
      {%- endif -%}
      {%- if s2 != blank -%}
        {{ s2 | image_url: width: 1600 | image_tag: class: 'andoh-cover__side-img', sizes: '(min-width: 750px) 60vw, 0px', widths: '600, 900, 1200, 1600', alt: '', loading: 'lazy' }}
      {%- endif -%}
      {%- if s3 != blank -%}
        {{ s3 | image_url: width: 1600 | image_tag: class: 'andoh-cover__side-img', sizes: '(min-width: 750px) 60vw, 0px', widths: '600, 900, 1200, 1600', alt: '', loading: 'lazy' }}
      {%- endif -%}
    </{{ side_tag }}>
  {%- endif -%}
  <div class="andoh-cover__content">
    <div class="andoh-cover__text">
      {%- if section.settings.eyebrow != blank -%}
        <div class="andoh-label andoh-cover__label">{{ section.settings.eyebrow | escape }}</div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="andoh-cover__heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="andoh-cover__body rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="andoh-link andoh-cover__link" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "andoh cover",
  "tag": "section",
  "class": "section andoh-cover-section",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Upload an MP4. It plays silently on a loop, edge to edge, and replaces the image."
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Or a YouTube or Vimeo link",
      "accept": [
        "youtube",
        "vimeo"
      ],
      "info": "Used only when no video is uploaded. An uploaded video loads faster and looks cleaner."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Shown edge to edge. 3000px wide or more looks best."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Phone image",
      "info": "Optional. A taller crop for phones."
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "default": "full",
      "options": [
        {
          "value": "full",
          "label": "Full screen"
        },
        {
          "value": "large",
          "label": "Large (80%)"
        },
        {
          "value": "medium",
          "label": "Medium (60%)"
        }
      ]
    },
    {
      "type": "select",
      "id": "position",
      "label": "Text position",
      "default": "bottom-left",
      "info": "Beside the logo shows only the heading, small, on the same line as the large logo.",
      "options": [
        {
          "value": "logo-line",
          "label": "Beside the logo (In Common With)"
        },
        {
          "value": "top-left",
          "label": "Top left"
        },
        {
          "value": "center-left",
          "label": "Middle left"
        },
        {
          "value": "bottom-left",
          "label": "Bottom left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom-right",
          "label": "Bottom right"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "Text color",
      "default": "light",
      "options": [
        {
          "value": "light",
          "label": "White"
        },
        {
          "value": "dark",
          "label": "Black"
        }
      ]
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Darken image",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 15,
      "info": "Helps white text read over a bright photo."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Objects for slow rooms"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Link label",
      "default": "Shop all objects"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Side panel"
    },
    {
      "type": "checkbox",
      "id": "side_show",
      "label": "Show a side panel on the right",
      "default": true,
      "info": "A narrow strip down the right edge, like In Common With. Hover over it and it slides open across the cover. Hidden on phones."
    },
    {
      "type": "image_picker",
      "id": "side_image_1",
      "label": "Side image",
      "info": "Leave empty to use the travertine side table photo built into the theme."
    },
    {
      "type": "image_picker",
      "id": "side_image_2",
      "label": "Second side image",
      "info": "Optional. With more than one image the panel cuts between them."
    },
    {
      "type": "image_picker",
      "id": "side_image_3",
      "label": "Third side image"
    },
    {
      "type": "range",
      "id": "side_width",
      "label": "Panel width",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "%",
      "default": 16
    },
    {
      "type": "range",
      "id": "side_open_width",
      "label": "Panel width on hover",
      "min": 20,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "side_interval",
      "label": "Seconds per image",
      "min": 2,
      "max": 10,
      "step": 0.5,
      "unit": "s",
      "default": 4
    },
    {
      "type": "url",
      "id": "side_link",
      "label": "Panel link",
      "info": "Optional. Clicking the panel goes here, for example the product page."
    }
  ],
  "presets": [
    {
      "name": "andoh cover"
    }
  ]
}
{% endschema %}
