<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="andoh-divider" style="height: {{ section.settings.height }}px;" aria-hidden="true">
    <div class="andoh-tp" style="height: 100%;">
      {%- if section.settings.image_taipei != blank -%}
        <div class="andoh-divider__img" style="background-image: url('{{ section.settings.image_taipei | image_url: height: 200 }}');"></div>
      {%- else -%}
        <svg><rect width="100%" height="100%" fill="url(#andoh-pattern-taipei)"/></svg>
      {%- endif -%}
    </div>
    <div class="andoh-ny" style="height: 100%;">
      {%- if section.settings.image_ny != blank -%}
        <div class="andoh-divider__img" style="background-image: url('{{ section.settings.image_ny | image_url: height: 200 }}');"></div>
      {%- else -%}
        <svg><rect width="100%" height="100%" fill="url(#andoh-pattern-ny)"/></svg>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "andoh divider",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "A hand-drawn band between sections. It switches with TAIPEI / NEW YORK. Upload your own drawings to replace the stand-in patterns; they repeat sideways." },
    { "type": "image_picker", "id": "image_taipei", "label": "Taipei drawing", "info": "For example iron window flowers or plum blossoms." },
    { "type": "image_picker", "id": "image_ny", "label": "New York drawing", "info": "For example fire escapes or water towers." },
    { "type": "range", "id": "height", "min": 24, "max": 120, "step": 4, "unit": "px", "label": "Height", "default": 44 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "andoh divider" }]
}
{% endschema %}
